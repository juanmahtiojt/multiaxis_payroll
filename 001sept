        // End date is 6 days after start date (7 days total)
        $endDateObj = clone $firstDate;
        $endDateObj->modify('+6 days');
        $endDate = $endDateObj->format('Y-m-d');
        break;

    case 'semi-monthly':
        // Determine if firstDate is in first half or second half of month
        $day = (int)$firstDate->format('d');
        $yearMonth = $firstDate->format('Y-m');

        if ($day <= 15) {
            // First half: 1st to 15th
            $startDate = $yearMonth . '-01';
            $endDate = $yearMonth . '-15';
        } else {
            // Second half: 16th to last day of month
            $startDate = $yearMonth . '-16';
            $endDateObj = new DateTime($yearMonth . '-01');
            $endDateObj->modify('last day of this month');
            $endDate = $endDateObj->format('Y-m-d');
        }
        break;

    case 'fixed':
    default:
        // Use full range of dates in entries
        $startDate = $firstDate->format('Y-m-d');
        $endDate = $lastDate->format('Y-m-d');
        break;
